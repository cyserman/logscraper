# Copy to <repo>/.env (git-ignored). Read by both systemd units.

# OpenAI-compatible endpoint: local Ollama, vLLM, or a bigger box on your tailnet
OLLAMA_BASE_URL=http://localhost:11434/v1
HERMES_MODEL=ollama/hermes3:latest

# Ollama SILENTLY truncates prompts longer than its context window -> missing events.
# Raise the server's window (OLLAMA_CONTEXT_LENGTH=16384, see README) and keep chunks well under it.
LOGSCRAPER_CHUNK_TOKENS=6000
# Seconds per LLM call. CPU-only VPS: several minutes per chunk is normal.
LOGSCRAPER_LLM_TIMEOUT=1800

# Phone UI: keep on loopback and reach it over an SSH tunnel (or set to your Tailscale IP)
LOGSCRAPER_HOST=127.0.0.1
LOGSCRAPER_PORT=8000

# Case label for worker output folders
LOGSCRAPER_CASE_ID=case_intake
