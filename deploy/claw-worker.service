# Processes anything dropped into incoming/.  Adjust /root/logscraper if cloned elsewhere.
[Unit]
Description=LogScraper Hermes Claw evidence worker
After=network-online.target ollama.service
Wants=network-online.target

[Service]
WorkingDirectory=/root/logscraper
EnvironmentFile=-/root/logscraper/.env
Environment=PYTHONUNBUFFERED=1
# Unbraced $VAR: an unset case id passes no argument (worker falls back to default_case)
ExecStart=/root/logscraper/.venv/bin/python claw_worker.py $LOGSCRAPER_CASE_ID --watch 30
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
